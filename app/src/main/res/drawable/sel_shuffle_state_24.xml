<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/shuffle_on"
        android:drawable="@drawable/ic_shuffle_on_24"
        android:state_checked="true" />
    <item
        android:id="@+id/shuffle_off"
        android:drawable="@drawable/ic_line_off_24" />

    <!-- Line retracts, logo arrows sketch in one by one, icon pops.
        Reversible so one AVD covers both directions.
        Resting appearance is unchanged from before. -->
    <transition
        android:drawable="@drawable/avd_shuffle_line_to_logo"
        android:fromId="@id/shuffle_off"
        android:reversible="true"
        android:toId="@id/shuffle_on" />
</animated-selector>