<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/shuffle_on"
        android:drawable="@drawable/ic_shuffle_on_24"
        android:state_checked="true" />
    <item
        android:id="@+id/shuffle_off"
        android:drawable="@drawable/ic_shuffle_off_24" />

    <!-- Morphs the icon shape on toggle; reversible so one AVD covers both directions.
        Resting appearance is unchanged from the old selector. -->
    <transition
        android:drawable="@drawable/avd_shuffle_off_to_on"
        android:fromId="@id/shuffle_off"
        android:reversible="true"
        android:toId="@id/shuffle_on" />
</animated-selector>